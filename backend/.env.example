POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/hospital_db
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CANCEL_CUTOFF_HOURS=2
CORS_ORIGINS=http://localhost:3000

# --- Prescription notifications (Gmail SMTP + Twilio SMS) ---
# SAFETY: keep both OFF until the site is fully built. When off, messages are
# only logged — no real email/SMS can leave the server. Real secrets go in
# your local .env (never committed). When testing, set an allowlist with only
# your own address/number so nobody else can receive anything.
NOTIFY_EMAIL_ENABLED=false
NOTIFY_SMS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
NOTIFY_ALLOWLIST=
