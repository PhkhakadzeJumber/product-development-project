# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Neon: Project > Connect > connection string (Frankfurt region)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# PostHog: public EU project API key from Project settings.
NEXT_PUBLIC_POSTHOG_KEY="phc_..."

# PostHog: browser ingestion path proxied to the EU region (the default if unset).
NEXT_PUBLIC_POSTHOG_HOST="/ingest"

# PostHog: project API key for server-side capture (unused in Sprint 1).
POSTHOG_KEY="phc_..."

# PostHog: EU ingestion host for server-side capture (unused in Sprint 1).
POSTHOG_HOST="https://eu.i.posthog.com"
